    "checklist.system.icps.desc": "Interim Cryogenic Propulsion Stage: a single RL10B-2 engine provides the ~3 050 m/s TLI burn after orbit insertion.",
    "checklist.system.core_stage": "Core Stage / RS-25",
    "checklist.system.core_stage.desc": "SLS core stage: four Shuttle-heritage RS-25 LH₂/LOX engines, ~7.4 MN total thrust.",
    "checklist.system.srbs": "SRBs — Solid boosters",
    "checklist.system.srbs.desc": "Solid Rocket Boosters: two five-segment solids provide ~75% of liftoff thrust during the first 126 s.",
